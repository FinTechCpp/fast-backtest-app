{
    "cmake.sourceDirectory": "${workspaceFolder}",
    
    // Configuration de CMake
    "cmake.configureOnOpen": true,
    "cmake.buildDirectory": "${workspaceFolder}/build",
    "cmake.exportCompileCommandsFile": true,
    "cmake.ignoreCMakeListsMissing": true,
    
    // Configuration C/C++ pour IntelliSense
    "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
    "C_Cpp.intelliSenseEngine": "default",
    "C_Cpp.autoAddFileAssociations": false,
    "C_Cpp.default.compileCommands": "${workspaceFolder}/build/compile_commands.json",
    "C_Cpp.default.includePath": [
        "${workspaceFolder}/**",
        "~/Qt/6.8.3/macos/include/**",
        "~/Qt/6.8.3/macos/mkspecs/macx-clang",
        "~/Qt/6.8.3/macos/lib/QtCore.framework/Headers",
        "~/Qt/6.8.3/macos/lib/QtGui.framework/Headers",
        "~/Qt/6.8.3/macos/lib/QtWidgets.framework/Headers",
        "~/Qt/6.8.3/macos/lib/QtNetwork.framework/Headers",
        "~/Qt/6.8.3/macos/lib/QtCharts.framework/Headers",
        "~/Qt/6.8.3/macos/lib/QtOpenGL.framework/Headers",
        "~/Qt/6.8.3/macos/lib/QtOpenGLWidgets.framework/Headers",
        "~/Qt/6.8.3/macos/lib/QtPrintSupport.framework/Headers",
        "${workspaceFolder}/cpp_backtestEngine/include",
        "${workspaceFolder}/cpp_strategies/include",
        "${workspaceFolder}/cpp_strategies/include/Strategies",
        "~/repos/ig-trading-bot/ChartDirector/include",
        "/usr/include/qt6/**",
        "/usr/include/x86_64-linux-gnu/qt6/**",

    ],
    "C_Cpp.default.cppStandard": "c++17",
    
    "files.associations": {
        "array": "cpp",
        "atomic": "cpp",
        "bit": "cpp",
        "cctype": "cpp",
        "charconv": "cpp",
        "chrono": "cpp",
        "clocale": "cpp",
        "cmath": "cpp",
        "compare": "cpp",
        "concepts": "cpp",
        "cstdarg": "cpp",
        "cstddef": "cpp",
        "cstdint": "cpp",
        "cstdio": "cpp",
        "cstdlib": "cpp",
        "ctime": "cpp",
        "cwchar": "cpp",
        "cwctype": "cpp",
        "deque": "cpp",
        "map": "cpp",
        "string": "cpp",
        "unordered_map": "cpp",
        "vector": "cpp",
        "exception": "cpp",
        "algorithm": "cpp",
        "functional": "cpp",
        "iterator": "cpp",
        "memory": "cpp",
        "memory_resource": "cpp",
        "numeric": "cpp",
        "optional": "cpp",
        "random": "cpp",
        "ratio": "cpp",
        "string_view": "cpp",
        "system_error": "cpp",
        "tuple": "cpp",
        "type_traits": "cpp",
        "utility": "cpp",
        "format": "cpp",
        "initializer_list": "cpp",
        "iomanip": "cpp",
        "iosfwd": "cpp",
        "istream": "cpp",
        "limits": "cpp",
        "new": "cpp",
        "numbers": "cpp",
        "ostream": "cpp",
        "span": "cpp",
        "sstream": "cpp",
        "stdexcept": "cpp",
        "streambuf": "cpp",
        "typeinfo": "cpp",
        "variant": "cpp",
        "iostream": "cpp",
        "any": "cpp",
        "typeindex": "cpp",
        "set": "cpp",
        "fstream": "cpp",
        "list": "cpp",
        "condition_variable": "cpp",
        "mutex": "cpp",
        "semaphore": "cpp",
        "stop_token": "cpp",
        "thread": "cpp",
        "*.txx": "cpp",
        "*.moc": "cpp",
        "ranges": "cpp",
        "cstring": "cpp",
        "bitset": "cpp",
        "codecvt": "cpp",
        "complex": "cpp",
        "forward_list": "cpp",
        "unordered_set": "cpp",
        "future": "cpp",
        "cinttypes": "cpp",
        "valarray": "cpp"
    },
    "yaml.schemas": {
        "https://json.schemastore.org/github-workflow.json": [
            ".github/workflows/*.yml",
            ".github/workflows/*.yaml"
        ]
    },
    "yaml.validate": true,
    "yaml.completion": true,
    
    // Configuration spécifique macOS
    "C_Cpp.default.macFrameworkPath": [
        "~/Qt/6.8.3/macos/lib",
        "/System/Library/Frameworks",
        "/Library/Frameworks"
    ],
    "C_Cpp.default.systemIncludePath": [
        "/usr/local/include",
        "/Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk/usr/include",
        "/Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk/usr/include/c++/v1",
        "/Applications/Xcode.app/Contents/Developer/Toolchains/XcodeDefault.xctoolchain/usr/lib/clang/*/include",
        "/Applications/Xcode.app/Contents/Developer/Toolchains/XcodeDefault.xctoolchain/usr/include"
    ],
    "cmake.generator": "Ninja"
}