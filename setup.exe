if C:\Users\%USERPROFILE%\miniconda3 is not empty : 
    curl https://repo.anaconda.com/miniconda/Miniconda3-latest-Windows-x86_64.exe -o .\miniconda.exe
    start /wait "" .\miniconda.exe /S
    del .\miniconda.exe

cd %USERPROFILE%\ig-trading-bot
conda activate trading
conda update -n base -c defaults conda
conda install -c conda-forge ta-lib
conda install -c conda-forge nodejs --update-deps
git fetch
git pull
pip install -r requirements.txt 
pip install -e .
cd lightweight-charts-python
pip install -e .
npm install
python build.py
cd ..


cd %USERPROFILE%\ig-trading-bot && git fetch && git pull && conda activate trading && python %USERPROFILE%\ig-trading-bot\backtest_interface\app_pyqt.py